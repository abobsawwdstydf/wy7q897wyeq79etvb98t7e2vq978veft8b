{
  "name": "@nexo/server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts -- ",
    "build": "echo 'Build not needed - using tsx'",
    "start": "tsx src/index.ts -- ",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "setup": "node -e \"const p=process.platform;const c=p==='win32'?'powershell -ExecutionPolicy Bypass -File ./setup.ps1':'bash ./setup.sh';require('child_process').execSync(c,{stdio:'inherit',cwd:__dirname})\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "@privacyresearch/libsignal-protocol-typescript": "^0.0.16",
    "@types/archiver": "^8.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/sharp": "^0.31.1",
    "archiver": "^8.0.0",
    "axios": "^1.14.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "file-type": "^16.5.4",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.21.0",
    "redis": "^5.11.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "tsx": "^4.19.2",
    "uuid": "^11.0.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^6.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^8.57.1",
    "prettier": "^3.8.4",
    "prisma": "^6.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
